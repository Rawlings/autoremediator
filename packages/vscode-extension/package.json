{
  "name": "autoremediator-rawlings",
  "displayName": "Node CVE Remediator",
  "version": "0.3.3",
  "description": "Find vulnerable Node.js dependencies in VS Code, ranked by real-world exploit risk (OSV, CISA KEV, EPSS), and fix them with Autoremediator's verified, agentic remediation",
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "agentic-remediation",
    "autofix",
    "cve",
    "dependabot-alternative",
    "dependency",
    "npm",
    "npm-audit",
    "remediation",
    "safe-upgrades",
    "sca",
    "security",
    "supply-chain",
    "vulnerability",
    "vulnerable-dependencies"
  ],
  "homepage": "https://github.com/Diffra/autoremediator#readme",
  "bugs": {
    "url": "https://github.com/Diffra/autoremediator/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diffra/autoremediator.git"
  },
  "publisher": "rawlings",
  "main": "./dist/extension.js",
  "scripts": {
    "clean": "rm -rf dist *.vsix",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "build:vsix": "pnpm build && pnpm package",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "^1.146.0",
    "@vscode/vsce": "^4.1.1",
    "autoremediator": "workspace:*",
    "esbuild": "^0.28.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "contributes": {
    "commands": [
      {
        "command": "autoremediator.scanWorkspace",
        "title": "Autoremediator: Scan workspace for CVEs"
      },
      {
        "command": "autoremediator.scanDelta",
        "title": "Autoremediator: Scan git delta against HEAD"
      },
      {
        "command": "autoremediator.checkReachability",
        "title": "Autoremediator: Check package AST reachability"
      },
      {
        "command": "autoremediator.previewPatch",
        "title": "Autoremediator: Preview patch artifact"
      },
      {
        "command": "autoremediator.fixCve",
        "title": "Fix with Autoremediator"
      }
    ]
  },
  "activationEvents": [
    "workspaceContains:**/package.json"
  ],
  "engines": {
    "vscode": "^1.146.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Autoremediator runs the project's package manager and its own CLI, which execute code from the workspace."
    }
  }
}
