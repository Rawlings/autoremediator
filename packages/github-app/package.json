{
  "name": "@autoremediator/github-app",
  "version": "0.1.2",
  "private": true,
  "description": "GitHub App MVP foundation for autoremediator",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm && tsc --emitDeclarationOnly --declaration",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "autoremediator": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
