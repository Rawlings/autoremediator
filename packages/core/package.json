{
  "name": "autoremediator",
  "version": "0.15.0",
  "private": false,
  "description": "Agentic CVE remediation platform for Node.js. Correlates threat intelligence, applies policy-governed fixes, and delivers auditable remediation outcomes across CI/CD pipelines, agent workflows, and service portfolios.",
  "keywords": [
    "agent-tooling",
    "agentic",
    "ai",
    "claude-mcp",
    "claude-mythos",
    "cve",
    "dependency-security",
    "devsecops",
    "ghsa",
    "github-advisory",
    "llm",
    "mcp",
    "mcp-server",
    "mythos",
    "node-security",
    "npm",
    "npm-audit",
    "npm-security",
    "nvd",
    "openapi",
    "osv",
    "pnpm",
    "remediation",
    "sarif",
    "sca",
    "scanner",
    "security",
    "security-remediation",
    "software-supply-chain",
    "supply-chain",
    "vulnerability-remediation",
    "yarn",
    "yarn-audit"
  ],
  "homepage": "https://github.com/Rawlings/autoremediator#readme",
  "bugs": {
    "url": "https://github.com/Rawlings/autoremediator/issues"
  },
  "license": "MIT",
  "author": "Rawlings",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rawlings/autoremediator.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/Rawlings"
  },
  "bin": {
    "autoremediator": "./dist/cli.js",
    "autoremediator-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/api/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js"
    },
    "./mcp": {
      "import": "./dist/mcp/server.js"
    },
    "./openapi": {
      "import": "./dist/openapi/server.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^22.0.1",
    "ai": "^7.0.74",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "oxc-parser": "^0.146.0",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/openai": "^4.0.45",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
