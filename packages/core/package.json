{
  "name": "autoremediator",
  "version": "0.23.0",
  "private": false,
  "description": "Agentic remediation for Node.js dependencies. Plans the smallest safe fix from your audit, a CVE or GHSA id, or a SARIF report, has an agent repair the code an upgrade breaks, verifies every change, and rolls back what fails.",
  "keywords": [
    "agent-tooling",
    "agentic",
    "agentic-remediation",
    "ai",
    "ai-agent",
    "ai-security",
    "auto-remediation",
    "autofix",
    "automated-dependency-updates",
    "automated-remediation",
    "claude-code",
    "claude-mcp",
    "claude-mythos",
    "codex",
    "coding-agent",
    "cursor",
    "cve",
    "dependabot-alternative",
    "dependency-management",
    "dependency-security",
    "dependency-vulnerabilities",
    "devsecops",
    "epss",
    "ghsa",
    "github-advisory",
    "kev",
    "llm",
    "mcp",
    "mcp-server",
    "mythos",
    "node-security",
    "npm",
    "npm-audit",
    "npm-audit-fix",
    "npm-security",
    "nvd",
    "openapi",
    "osv",
    "pnpm",
    "reachability",
    "remediation",
    "safe-upgrades",
    "sarif",
    "sbom",
    "sca",
    "security",
    "security-patches",
    "security-remediation",
    "software-supply-chain",
    "supply-chain",
    "vex",
    "vulnerability-management",
    "vulnerability-remediation",
    "vulnerable-dependencies",
    "yarn"
  ],
  "homepage": "https://github.com/Diffra/autoremediator#readme",
  "bugs": {
    "url": "https://github.com/Diffra/autoremediator/issues"
  },
  "license": "MIT",
  "author": "Rawlings",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diffra/autoremediator.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/Rawlings"
  },
  "bin": {
    "autoremediator": "./dist/surfaces/cli/index.js",
    "autoremediator-mcp": "./dist/surfaces/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "type": "module",
  "main": "./dist/api/index.js",
  "types": "./dist/api/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./cli": {
      "import": "./dist/surfaces/cli/index.js"
    },
    "./mcp": {
      "import": "./dist/surfaces/mcp/server.js"
    },
    "./openapi": {
      "import": "./dist/surfaces/openapi/server.js"
    },
    "./trace": {
      "types": "./dist/features/trace/register.d.ts",
      "import": "./dist/features/trace/register.js",
      "require": "./dist/features/trace/register.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "prepack": "node -e \"for (const f of ['README.md','llms.txt']) require('node:fs').copyFileSync('../../'+f, f)\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.172",
    "commander": "^15.1.0",
    "execa": "^10.2.1",
    "oxc-parser": "^0.158.0",
    "semver": "^7.8.6",
    "yaml": "catalog:",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.104",
    "@ai-sdk/openai": "^4.0.117",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
