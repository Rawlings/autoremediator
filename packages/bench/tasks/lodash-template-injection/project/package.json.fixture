{
  "name": "bench-app-lodash-template-injection",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "node \"$BENCH_TSC\" -p tsconfig.json",
    "test": "node --permission --allow-fs-read=\"$PWD\" --test-isolation=none --test test/*.test.ts"
  },
  "dependencies": {
    "lodash": "4.17.20"
  },
  "devDependencies": {
    "@types/lodash": "4.17.20"
  }
}
